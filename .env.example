# Opcional: sobrescreve src/firebasePublicConfig.ts no build local/Vercel.
# A config web do Firebase é pública; service accounts nunca devem ir para o Git.
# VITE_FIREBASE_PROJECT_ID=escalaead
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=escalaead.firebaseapp.com
# VITE_FIREBASE_STORAGE_BUCKET=escalaead.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# Scripts administrativos (somente local, fora do repositório):
# FIREBASE_WEB_API_KEY=
# OLD_FIREBASE_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\fora\do\repositorio\service-account.json
