rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function authIndexExists() {
      return exists(/databases/$(database)/documents/auth_index/$(authEmail()));
    }

    function callerPerfil() {
      return get(/databases/$(database)/documents/auth_index/$(authEmail())).data.perfil;
    }

    function isAdmin() {
      return signedIn() && authIndexExists() && callerPerfil() == 'Administrador';
    }

    function isGestor() {
      return signedIn() && authIndexExists() && callerPerfil() == 'Gestor';
    }

    function isOperador() {
      return signedIn() && authIndexExists() && callerPerfil() == 'Operador';
    }

    function isRegistered() {
      return signedIn() && authIndexExists();
    }

    function canEditCadastro() {
      return isAdmin() || isOperador();
    }

    function statusIn(data, values) {
      return data.keys().hasAny(['status']) && data.status in values;
    }

    function sameStatus() {
      return request.resource.data.status == resource.data.status;
    }

    // Transições de workflow enforceadas no servidor (sem Cloud Functions).
    function workflowSubmit() {
      return isAdmin()
        && resource.data.status in ['em_edicao', 'revisao_solicitada']
        && request.resource.data.status == 'aguardando_aprovacao';
    }

    function workflowApprove() {
      return isGestor()
        && resource.data.status == 'aguardando_aprovacao'
        && request.resource.data.status == 'aprovada';
    }

    function workflowRevision() {
      return isGestor()
        && resource.data.status == 'aguardando_aprovacao'
        && request.resource.data.status == 'revisao_solicitada';
    }

    function workflowCancel() {
      return isAdmin()
        && resource.data.status == 'aguardando_aprovacao'
        && request.resource.data.status == 'em_edicao';
    }

    function workflowReopen() {
      return isGestor()
        && resource.data.status == 'aprovada'
        && request.resource.data.status == 'em_edicao';
    }

    function workflowContentEdit() {
      return canEditCadastro()
        && sameStatus()
        && !(resource.data.status in ['aprovada', 'aguardando_aprovacao']);
    }

    function canWriteWorkflowDoc() {
      return workflowContentEdit()
        || workflowSubmit()
        || workflowApprove()
        || workflowRevision()
        || workflowCancel()
        || workflowReopen();
    }

    function canCreateWorkflowDoc() {
      return canEditCadastro()
        && (
          !('status' in request.resource.data)
          || request.resource.data.status == 'em_edicao'
        );
    }

    // Índice e-mail → perfil (escrito no login / save de usuários)
    match /auth_index/{email} {
      allow read: if signedIn() && authEmail() == email;
      allow create, update: if signedIn() && (authEmail() == email || isAdmin());
      allow delete: if isAdmin();
    }

    match /logs/{id} {
      allow read: if isAdmin();
      // timestamp deve ser serverTimestamp() (== request.time nas rules)
      allow create: if signedIn()
        && request.resource.data.keys().hasAny(['timestamp'])
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    match /counters/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /usuarios/{re} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        || (signedIn() && request.resource.data.email == authEmail());
      allow delete: if isAdmin();
    }

    match /colaboradores/{id} {
      allow read: if isRegistered();
      allow write: if canEditCadastro();
    }

    match /secoes/{id} {
      allow read: if isRegistered();
      allow write: if isAdmin();
    }

    match /postos/{id} {
      allow read: if isRegistered();
      allow write: if isAdmin();
    }

    match /legendas/{id} {
      allow read: if isRegistered();
      allow write: if isAdmin();
    }

    match /configuracoes/{id} {
      allow read: if isRegistered();
      allow write: if isAdmin();
    }

    match /escalas_semanais/{id} {
      allow read: if isRegistered();
      allow create: if canCreateWorkflowDoc();
      allow update: if canWriteWorkflowDoc();
      allow delete: if isAdmin();
    }

    match /escalas_alteracao/{id} {
      allow read: if isRegistered();
      allow create: if canCreateWorkflowDoc();
      allow update: if canWriteWorkflowDoc();
      allow delete: if isAdmin();
    }

    match /controle_frequencia/{id} {
      allow read: if isRegistered();
      allow create: if canCreateWorkflowDoc();
      allow update: if canWriteWorkflowDoc();
      allow delete: if isAdmin();
    }

    match /solicitacoes_aprovacao/{id} {
      allow read: if isRegistered();
      allow create: if isAdmin();
      allow update: if isAdmin() || isGestor();
      allow delete: if isAdmin();
    }

    match /presenca_online/{id} {
      allow read: if isRegistered();
      allow write: if isRegistered();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
