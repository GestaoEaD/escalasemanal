rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // As regras precisam caber no limite de 1000 expressões avaliadas por
    // requisição. Por isso o perfil é comparado direto via callerPerfil()/
    // perfilIn() em vez de encadear vários predicados isAdmin()/isGestor()/...
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    // Identidade da conta Google: no Gmail, pontos e sufixo "+alias" não fazem
    // parte do endereço, então "joao.silva@gmail.com" e "joaosilva@gmail.com"
    // são a mesma caixa. O token pode chegar em qualquer variação, por isso a
    // comparação com o cadastro é feita sempre por esta chave.
    function emailKeyDe(e) {
      return e.split('@').size() != 2
        ? e
        : (e.split('@')[1].matches('gmail\\.com|googlemail\\.com')
            ? e.split('@')[0].split('\\+')[0].replace('\\.', '') + '@gmail.com'
            : e);
    }

    function tokenEmailKey() {
      return emailKeyDe(authEmail());
    }

    // Em consultas (`list`) só os campos filtrados são legíveis: tocar em outro
    // campo é erro de avaliação. Os dois termos existem por isso — a consulta do
    // login filtra `emailKey`, o termo literal cobre leitura por documento e
    // cadastros legados sem `emailKey`. O erro de um termo é absorvido pelo `||`,
    // então cada forma de consulta é autorizada pelo termo que lhe corresponde.
    function ehDonoDoCadastro(data) {
      return data.get('emailKey', '') == tokenEmailKey()
        || emailKeyDe(data.get('email', '')) == tokenEmailKey();
    }

    function isRegistered() {
      return signedIn()
        && exists(/databases/$(database)/documents/auth_index/$(authEmail()))
        && callerIndex().get('ativo', true) == true;
    }

    function callerIndex() {
      return get(/databases/$(database)/documents/auth_index/$(authEmail())).data;
    }

    function callerPerfil() {
      return callerIndex().perfil;
    }

    function callerDivisao() {
      return callerIndex().divisaoId;
    }

    function callerRe() {
      return callerIndex().re;
    }

    function perfilIn(perfis) {
      return isRegistered() && callerPerfil() in perfis;
    }

    function isAdmin() {
      return perfilIn(['Administrador']);
    }

    function isGestor() {
      return perfilIn(['Gestor']);
    }

    function isOperador() {
      return perfilIn(['Operador']);
    }

    function isGerente() {
      return perfilIn(['Gerente']);
    }

    function docInexistente() {
      return resource == null;
    }

    function sameDivisao(data) {
      return data.keys().hasAny(['divisaoId']) && data.divisaoId == callerDivisao();
    }

    function hasSecaoId(data) {
      return data.keys().hasAny(['secaoId']);
    }

    // Nenhum perfil, inclusive Gerente, pode gravar sem os campos de tenant:
    // a UI reescreve documentos inteiros e perdê-los tornaria o doc ilegível.
    function tenantFieldsPresentes(data) {
      return data.keys().hasAny(['divisaoId']) && hasSecaoId(data);
    }

    // Admin nunca cria, promove, edita ou remove Gerente.
    function adminUsuarioPerfilOk() {
      return request.resource.data.keys().hasAny(['perfil'])
        && request.resource.data.perfil != 'Gerente'
        && (
          resource == null
          || !resource.data.keys().hasAny(['perfil'])
          || resource.data.perfil != 'Gerente'
        );
    }

    function sectionRead() {
      return isRegistered()
        && (
          docInexistente()
          || callerPerfil() == 'Gerente'
          || (hasSecaoId(resource.data) && sameDivisao(resource.data))
        );
    }

    function sectionCreateOk() {
      return tenantFieldsPresentes(request.resource.data)
        && isRegistered()
        && (
          callerPerfil() == 'Gerente'
          || sameDivisao(request.resource.data)
        );
    }

    function sectionUpdateOk() {
      return tenantFieldsPresentes(request.resource.data)
        // divisaoId é imutável para todos os perfis: o ID do documento o embute.
        && resource.data.get('divisaoId', request.resource.data.divisaoId)
          == request.resource.data.divisaoId
        && isRegistered()
        && (
          callerPerfil() == 'Gerente'
          || (hasSecaoId(resource.data) && sameDivisao(resource.data))
        );
    }

    function tenantRead() {
      return isRegistered()
        && (
          docInexistente()
          || callerPerfil() == 'Gerente'
          || sameDivisao(resource.data)
        );
    }

    function tenantCreateOk() {
      return isRegistered()
        && (
          callerPerfil() == 'Gerente'
          || sameDivisao(request.resource.data)
        );
    }

    function tenantUpdateOk() {
      return request.resource.data.keys().hasAny(['divisaoId'])
        && resource.data.keys().hasAny(['divisaoId'])
        && request.resource.data.divisaoId == resource.data.divisaoId
        && isRegistered()
        && (
          callerPerfil() == 'Gerente'
          || resource.data.divisaoId == callerDivisao()
        );
    }

    function tenantDeleteOk() {
      return isRegistered()
        && (
          callerPerfil() == 'Gerente'
          || (
            callerPerfil() == 'Administrador'
            && resource.data.keys().hasAny(['divisaoId'])
            && resource.data.divisaoId == callerDivisao()
          )
        );
    }

    function canEditCadastro() {
      return perfilIn(['Administrador', 'Gerente']);
    }

    function canSubmitRole() {
      return perfilIn(['Administrador', 'Operador', 'Gerente']);
    }

    function canApproveRole() {
      return perfilIn(['Gestor', 'Gerente']);
    }

    function statusAtual() {
      return resource.data.get('status', 'em_edicao');
    }

    function statusNovo() {
      return request.resource.data.get('status', 'em_edicao');
    }

    function canWriteWorkflowDoc() {
      return sectionUpdateOk()
        && (
          (canSubmitRole()
            && (
              (statusNovo() == statusAtual()
                && !(statusAtual() in ['aprovada', 'aguardando_aprovacao']))
              || (statusAtual() in ['em_edicao', 'revisao_solicitada']
                && statusNovo() == 'aguardando_aprovacao')
              || (statusAtual() == 'aguardando_aprovacao'
                && statusNovo() == 'em_edicao')
            ))
          || (canApproveRole()
            && (
              (statusAtual() == 'aguardando_aprovacao'
                && statusNovo() in ['aprovada', 'revisao_solicitada'])
              || (statusAtual() == 'aprovada'
                && statusNovo() == 'em_edicao')
            ))
        );
    }

    function canCreateWorkflowDoc() {
      return canSubmitRole()
        && sectionCreateOk()
        && statusNovo() == 'em_edicao';
    }

    // Operador só acessa a própria Seção em controle_frequencia; demais
    // perfis (Admin/Gestor/Gerente) continuam com escopo de Divisão.
    function frequenciaReadOk() {
      return isRegistered()
        && (
          docInexistente()
          || callerPerfil() == 'Gerente'
          || (
            hasSecaoId(resource.data) && sameDivisao(resource.data)
            && (callerPerfil() != 'Operador'
              || resource.data.secaoId == callerIndex().secaoId)
          )
        );
    }

    function frequenciaWriteSecaoOk() {
      return callerPerfil() != 'Operador'
        || (hasSecaoId(request.resource.data)
          && request.resource.data.secaoId == callerIndex().secaoId);
    }

    // Escalas Semanal/Alteração: documento por Divisão (sem secaoId no doc).
    function divisaoWorkflowCreateOk() {
      return request.resource.data.keys().hasAny(['divisaoId'])
        && !request.resource.data.keys().hasAny(['secaoId'])
        && isRegistered()
        && (
          callerPerfil() == 'Gerente'
          || sameDivisao(request.resource.data)
        );
    }

    function divisaoWorkflowUpdateOk() {
      return request.resource.data.keys().hasAny(['divisaoId'])
        && !request.resource.data.keys().hasAny(['secaoId'])
        && resource.data.get('divisaoId', request.resource.data.divisaoId)
          == request.resource.data.divisaoId
        && isRegistered()
        && (
          callerPerfil() == 'Gerente'
          || sameDivisao(resource.data)
        );
    }

    // Ao aprovar/reabrir, o Gestor/Gerente só pode alterar metadados de
    // workflow — nunca o conteúdo (rows, observações etc.) do documento.
    function divisaoWorkflowMetaOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'aprovacao', 'historico', 'versao', 'lastSaved', 'updatedAt', 'solicitacaoId']);
    }

    function canWriteDivisaoWorkflowDoc() {
      return divisaoWorkflowUpdateOk()
        && (
          (canSubmitRole()
            && (
              (statusNovo() == statusAtual()
                && !(statusAtual() in ['aprovada', 'aguardando_aprovacao']))
              || (statusAtual() in ['em_edicao', 'revisao_solicitada']
                && statusNovo() == 'aguardando_aprovacao')
              || (statusAtual() == 'aguardando_aprovacao'
                && statusNovo() == 'em_edicao')
            ))
          || (canApproveRole()
            && divisaoWorkflowMetaOnly()
            && (
              (statusAtual() == 'aguardando_aprovacao'
                && statusNovo() in ['aprovada', 'revisao_solicitada'])
              || (statusAtual() == 'aprovada'
                && statusNovo() == 'em_edicao')
            ))
        );
    }

    function canCreateDivisaoWorkflowDoc() {
      return canSubmitRole()
        && divisaoWorkflowCreateOk()
        && statusNovo() == 'em_edicao';
    }

    // solicitacoes_aprovacao só transiciona AGUARDANDO -> FINALIZADA, e o
    // "resultado" gravado precisa condizer com o papel de quem grava:
    // aprovador registra APROVADA/REVISAO_SOLICITADA, autor cancela.
    function solicitacaoStatusAtual() {
      return resource.data.get('status', 'AGUARDANDO');
    }

    function solicitacaoStatusNovo() {
      return request.resource.data.get('status', 'AGUARDANDO');
    }

    function solicitacaoResultadoNovo() {
      return request.resource.data.get('resultado', null);
    }

    function canFinalizeSolicitacao() {
      return solicitacaoStatusAtual() == 'AGUARDANDO'
        && solicitacaoStatusNovo() == 'FINALIZADA'
        && (
          (canApproveRole()
            && solicitacaoResultadoNovo() in ['APROVADA', 'REVISAO_SOLICITADA'])
          || (canSubmitRole() && solicitacaoResultadoNovo() == 'CANCELADA')
        );
    }

    function usuarioDoc(re) {
      return get(/databases/$(database)/documents/usuarios/$(re)).data;
    }

    function authIndexMirrorsUsuario() {
      return request.resource.data.keys().hasAll(['re', 'perfil', 'divisaoId', 'email'])
        && request.resource.data.email == authEmail()
        && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.re))
        && ehDonoDoCadastro(usuarioDoc(request.resource.data.re))
        && usuarioDoc(request.resource.data.re).get('ativo', true) == true
        && usuarioDoc(request.resource.data.re).perfil == request.resource.data.perfil
        && usuarioDoc(request.resource.data.re).divisaoId == request.resource.data.divisaoId
        && usuarioDoc(request.resource.data.re).get('secaoId', request.resource.data.get('secaoId', ''))
          == request.resource.data.get('secaoId', '');
    }

    function adminAuthIndexMirrorsUsuario(email) {
      return isAdmin()
        && request.resource.data.keys().hasAll(['re', 'perfil', 'divisaoId', 'email'])
        && request.resource.data.email == email
        && request.resource.data.divisaoId == callerDivisao()
        && request.resource.data.perfil != 'Gerente'
        && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.re))
        && emailKeyDe(usuarioDoc(request.resource.data.re).get('email', '')) == emailKeyDe(email)
        && usuarioDoc(request.resource.data.re).get('ativo', true) == true
        && usuarioDoc(request.resource.data.re).divisaoId == callerDivisao()
        && usuarioDoc(request.resource.data.re).perfil == request.resource.data.perfil
        && (
          resource == null
          || (
            resource.data.keys().hasAll(['divisaoId', 'perfil'])
            && resource.data.divisaoId == callerDivisao()
            && resource.data.perfil != 'Gerente'
          )
        );
    }

    match /auth_index/{email} {
      allow read: if signedIn() && authEmail() == email;
      allow create, update: if signedIn()
        && (
          isGerente()
          || adminAuthIndexMirrorsUsuario(email)
          || (authEmail() == email && authIndexMirrorsUsuario())
        );
      allow delete: if isRegistered()
        && (
          callerPerfil() == 'Gerente'
          || (
            callerPerfil() == 'Administrador'
            && resource != null
            && resource.data.keys().hasAll(['divisaoId', 'perfil'])
            && resource.data.divisaoId == callerDivisao()
            && resource.data.perfil != 'Gerente'
          )
        );
    }

    match /divisoes/{id} {
      allow read: if isRegistered()
        && (
          docInexistente()
          || callerPerfil() == 'Gerente'
          || (resource.data.keys().hasAny(['codigo'])
              && resource.data.codigo == callerDivisao())
        );
      allow create, update, delete: if isGerente();
    }

    match /logs/{id} {
      allow read: if isRegistered()
        && (
          callerPerfil() == 'Gerente'
          || (
            callerPerfil() == 'Administrador'
            && !docInexistente()
            && resource.data.keys().hasAny(['divisaoId'])
            && resource.data.divisaoId == callerDivisao()
          )
        );
      allow create: if isRegistered()
        && request.resource.data.keys().hasAny(['timestamp'])
        && request.resource.data.timestamp == request.time
        && (
          callerPerfil() == 'Gerente'
          || (request.resource.data.keys().hasAny(['divisaoId'])
            && request.resource.data.divisaoId == callerDivisao())
        );
      allow update, delete: if false;
    }

    match /counters/{id} {
      allow read: if isRegistered();
      // allocateLogId() (counters/logs) é gravado por qualquer usuário
      // registrado ao auditar sua própria ação; demais contadores só Gerente.
      allow write: if isGerente() || (id == 'logs' && isRegistered());
    }

    match /usuarios/{re} {
      allow read: if sectionRead()
        || (
          signedIn()
          && !docInexistente()
          && ehDonoDoCadastro(resource.data)
        );
      allow create: if (isGerente() && sectionCreateOk())
        || (isAdmin() && sectionCreateOk() && adminUsuarioPerfilOk());
      allow update: if isGerente()
        || (isAdmin()
          && sectionUpdateOk()
          && adminUsuarioPerfilOk()
          && !ehDonoDoCadastro(resource.data))
        || (
          signedIn()
          && ehDonoDoCadastro(resource.data)
          && ehDonoDoCadastro(request.resource.data)
          && request.resource.data.perfil == resource.data.perfil
          && request.resource.data.divisaoId == resource.data.divisaoId
          && request.resource.data.secaoId == resource.data.secaoId
          && request.resource.data.re == resource.data.re
        );
      allow delete: if isRegistered()
        && (
          callerPerfil() == 'Gerente'
          || (
            callerPerfil() == 'Administrador'
            && resource.data.keys().hasAny(['divisaoId'])
            && resource.data.divisaoId == callerDivisao()
            && (
              !resource.data.keys().hasAny(['perfil'])
              || resource.data.perfil != 'Gerente'
            )
          )
        );
    }

    match /colaboradores/{id} {
      allow read: if sectionRead();
      allow create: if canEditCadastro() && sectionCreateOk();
      allow update: if canEditCadastro() && sectionUpdateOk();
      allow delete: if canEditCadastro() && tenantDeleteOk();
    }

    match /secoes/{id} {
      allow read: if tenantRead();
      allow create: if canEditCadastro()
        && tenantCreateOk()
        && request.resource.data.keys().hasAny(['divisaoId'])
        && !request.resource.data.keys().hasAny(['secaoId']);
      allow update: if canEditCadastro()
        && tenantUpdateOk()
        && !request.resource.data.keys().hasAny(['secaoId']);
      allow delete: if tenantDeleteOk();
    }

    match /postos/{id} {
      allow read: if tenantRead();
      allow create: if isGerente() && tenantCreateOk();
      allow update: if isGerente() && tenantUpdateOk();
      allow delete: if isGerente();
    }

    match /legendas/{id} {
      allow read: if isRegistered();
      allow create, update, delete: if isGerente();
    }

    match /configuracoes/{id} {
      allow read: if isRegistered();
      allow write: if isGerente();
    }

    match /escalas_semanais/{id} {
      allow read: if tenantRead();
      allow create: if canCreateDivisaoWorkflowDoc();
      allow update: if canWriteDivisaoWorkflowDoc();
      allow delete: if tenantDeleteOk();
    }

    match /escalas_alteracao/{id} {
      allow read: if tenantRead();
      allow create: if canCreateDivisaoWorkflowDoc();
      allow update: if canWriteDivisaoWorkflowDoc();
      allow delete: if tenantDeleteOk();
    }

    match /controle_frequencia/{id} {
      allow read: if frequenciaReadOk();
      allow create: if canCreateWorkflowDoc() && frequenciaWriteSecaoOk();
      allow update: if canWriteWorkflowDoc() && frequenciaWriteSecaoOk();
      allow delete: if tenantDeleteOk();
    }

    match /solicitacoes_aprovacao/{id} {
      allow read: if sectionRead();
      allow create: if canSubmitRole() && sectionCreateOk();
      allow update: if sectionUpdateOk()
        && request.resource.data.secaoId == resource.data.secaoId
        && canFinalizeSolicitacao();
      allow delete: if tenantDeleteOk();
    }

    match /presenca_online/{id} {
      allow read: if isRegistered()
        && (
          docInexistente()
          || callerPerfil() == 'Gerente'
          || (resource.data.keys().hasAny(['divisaoId'])
            && resource.data.divisaoId == callerDivisao())
        );
      allow create, update: if isRegistered()
        && request.resource.data.keys().hasAny(['re'])
        && request.resource.data.re == callerRe()
        && (
          callerPerfil() == 'Gerente'
          || (request.resource.data.keys().hasAny(['divisaoId'])
            && request.resource.data.divisaoId == callerDivisao())
        );
      allow delete: if isRegistered()
        && (
          (resource.data.keys().hasAny(['re']) && resource.data.re == callerRe())
          || callerPerfil() == 'Gerente'
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
