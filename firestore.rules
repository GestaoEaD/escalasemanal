rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function authIndexExists() {
      return exists(/databases/$(database)/documents/auth_index/$(authEmail()));
    }

    function callerPerfil() {
      return get(/databases/$(database)/documents/auth_index/$(authEmail())).data.perfil;
    }

    function callerDivisao() {
      return get(/databases/$(database)/documents/auth_index/$(authEmail())).data.divisaoId;
    }

    function callerRe() {
      return get(/databases/$(database)/documents/auth_index/$(authEmail())).data.re;
    }

    function isAdmin() {
      return signedIn() && authIndexExists() && callerPerfil() == 'Administrador';
    }

    function isGestor() {
      return signedIn() && authIndexExists() && callerPerfil() == 'Gestor';
    }

    function isOperador() {
      return signedIn() && authIndexExists() && callerPerfil() == 'Operador';
    }

    function isGerente() {
      return signedIn() && authIndexExists() && callerPerfil() == 'Gerente';
    }

    function isRegistered() {
      return signedIn() && authIndexExists();
    }

    function docInexistente() {
      return resource == null;
    }

    function sameDivisao(data) {
      return data.keys().hasAny(['divisaoId']) && data.divisaoId == callerDivisao();
    }

    function hasSecaoId(data) {
      return data.keys().hasAny(['secaoId']);
    }

    function accessByRole(data) {
      return isGerente()
        || ((isAdmin() || isGestor() || isOperador())
          && sameDivisao(data)
          && hasSecaoId(data));
    }

    // Admin nunca cria, promove, edita ou remove Gerente.
    function adminUsuarioPerfilOk() {
      return request.resource.data.keys().hasAny(['perfil'])
        && request.resource.data.perfil != 'Gerente'
        && (
          resource == null
          || !resource.data.keys().hasAny(['perfil'])
          || resource.data.perfil != 'Gerente'
        );
    }

    function sectionRead() {
      return isGerente()
        || (isRegistered()
            && docInexistente())
        || (isRegistered()
            && hasSecaoId(resource.data)
            && accessByRole(resource.data));
    }

    function sectionCreateOk() {
      return isGerente()
        || (isRegistered()
            && hasSecaoId(request.resource.data)
            && accessByRole(request.resource.data));
    }

    function sectionUpdateOk() {
      return isGerente()
        || (isRegistered()
            && hasSecaoId(resource.data)
            && hasSecaoId(request.resource.data)
            && resource.data.divisaoId == request.resource.data.divisaoId
            && accessByRole(resource.data)
            && accessByRole(request.resource.data));
    }

    function tenantRead() {
      return isGerente()
        || (isRegistered() && !docInexistente() && sameDivisao(resource.data));
    }

    function tenantCreateOk() {
      return isGerente()
        || (isRegistered()
            && request.resource.data.keys().hasAny(['divisaoId'])
            && request.resource.data.divisaoId == callerDivisao());
    }

    function tenantUpdateOk() {
      return request.resource.data.keys().hasAny(['divisaoId'])
        && resource.data.keys().hasAny(['divisaoId'])
        && request.resource.data.divisaoId == resource.data.divisaoId
        && (
          isGerente()
          || (isRegistered() && resource.data.divisaoId == callerDivisao())
        );
    }

    function canEditCadastro() {
      return isAdmin() || isGerente();
    }

    function canSubmitRole() {
      return isAdmin() || isOperador() || isGerente();
    }

    function canApproveRole() {
      return isGestor() || isGerente();
    }

    function sameStatus() {
      return request.resource.data.status == resource.data.status;
    }

    function canWriteWorkflowDoc() {
      return sectionUpdateOk()
        && (
          (canSubmitRole()
            && sameStatus()
            && !(resource.data.status in ['aprovada', 'aguardando_aprovacao']))
          || (canSubmitRole()
            && resource.data.status in ['em_edicao', 'revisao_solicitada']
            && request.resource.data.status == 'aguardando_aprovacao')
          || (canApproveRole()
            && resource.data.status == 'aguardando_aprovacao'
            && request.resource.data.status in ['aprovada', 'revisao_solicitada'])
          || (canSubmitRole()
            && resource.data.status == 'aguardando_aprovacao'
            && request.resource.data.status == 'em_edicao')
          || (canApproveRole()
            && resource.data.status == 'aprovada'
            && request.resource.data.status == 'em_edicao')
        );
    }

    function canCreateWorkflowDoc() {
      return canSubmitRole()
        && sectionCreateOk()
        && request.resource.data.keys().hasAll(['divisaoId', 'secaoId'])
        && (
          !('status' in request.resource.data)
          || request.resource.data.status == 'em_edicao'
        );
    }

    function tenantDeleteOk() {
      return isGerente()
        || (isAdmin() && resource.data.keys().hasAny(['divisaoId'])
            && resource.data.divisaoId == callerDivisao());
    }

    function authIndexMirrorsUsuario() {
      return request.resource.data.keys().hasAll(['re', 'perfil', 'divisaoId', 'email'])
        && request.resource.data.email == authEmail()
        && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.re))
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.re)).data.email == authEmail()
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.re)).data.perfil == request.resource.data.perfil
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.re)).data.divisaoId == request.resource.data.divisaoId
        && (
          !get(/databases/$(database)/documents/usuarios/$(request.resource.data.re)).data.keys().hasAny(['secaoId'])
          || get(/databases/$(database)/documents/usuarios/$(request.resource.data.re)).data.secaoId == request.resource.data.secaoId
        )
        && (
          !get(/databases/$(database)/documents/usuarios/$(request.resource.data.re)).data.keys().hasAny(['secoesResponsaveisIds'])
          || get(/databases/$(database)/documents/usuarios/$(request.resource.data.re)).data.secoesResponsaveisIds == request.resource.data.secoesResponsaveisIds
        );
    }

    function adminAuthIndexMirrorsUsuario(email) {
      return isAdmin()
        && request.resource.data.keys().hasAll(['re', 'perfil', 'divisaoId', 'email'])
        && request.resource.data.email == email
        && request.resource.data.divisaoId == callerDivisao()
        && request.resource.data.perfil != 'Gerente'
        && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.re))
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.re)).data.email == email
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.re)).data.divisaoId == callerDivisao()
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.re)).data.perfil == request.resource.data.perfil
        && (
          resource == null
          || (
            resource.data.keys().hasAll(['divisaoId', 'perfil'])
            && resource.data.divisaoId == callerDivisao()
            && resource.data.perfil != 'Gerente'
          )
        );
    }

    match /auth_index/{email} {
      allow read: if signedIn() && authEmail() == email;
      allow create, update: if signedIn()
        && (
          isGerente()
          || adminAuthIndexMirrorsUsuario(email)
          || (authEmail() == email && authIndexMirrorsUsuario())
        );
      allow delete: if isGerente()
        || (isAdmin()
          && resource != null
          && resource.data.keys().hasAll(['divisaoId', 'perfil'])
          && resource.data.divisaoId == callerDivisao()
          && resource.data.perfil != 'Gerente');
    }

    match /divisoes/{id} {
      allow read: if isGerente()
        || (isRegistered() && docInexistente())
        || (isRegistered() && resource.data.keys().hasAny(['codigo'])
            && resource.data.codigo == callerDivisao());
      allow create, update, delete: if isGerente();
    }

    match /logs/{id} {
      allow read: if isGerente()
        || (isAdmin() && !docInexistente()
            && resource.data.keys().hasAny(['divisaoId'])
            && resource.data.divisaoId == callerDivisao());
      allow create: if isRegistered()
        && request.resource.data.keys().hasAny(['timestamp'])
        && request.resource.data.timestamp == request.time
        && (
          isGerente()
          || !request.resource.data.keys().hasAny(['divisaoId'])
          || request.resource.data.divisaoId == callerDivisao()
        );
      allow update, delete: if false;
    }

    match /counters/{id} {
      allow read: if isRegistered();
      allow write: if isRegistered();
    }

    match /usuarios/{re} {
      allow read: if isGerente()
        || (isRegistered() && docInexistente())
        || (signedIn() && resource.data.keys().hasAny(['email']) && resource.data.email == authEmail())
        || (isAdmin() && sectionRead())
        || (isGestor() && sectionRead())
        || (isOperador() && sectionRead());
      allow create: if isGerente()
        && sectionCreateOk()
        && request.resource.data.keys().hasAll(['divisaoId', 'secaoId'])
        || (isAdmin()
          && sectionCreateOk()
          && adminUsuarioPerfilOk()
          && request.resource.data.keys().hasAll(['divisaoId', 'secaoId']));
      allow update: if isGerente()
        || (isAdmin()
          && sectionUpdateOk()
          && adminUsuarioPerfilOk()
          && !(resource.data.keys().hasAny(['email']) && resource.data.email == authEmail()))
        || (
          signedIn()
          && resource.data.keys().hasAny(['email'])
          && resource.data.email == authEmail()
          && request.resource.data.email == authEmail()
          && request.resource.data.perfil == resource.data.perfil
          && request.resource.data.divisaoId == resource.data.divisaoId
          && request.resource.data.secaoId == resource.data.secaoId
          && (
            !resource.data.keys().hasAny(['secoesResponsaveisIds'])
              ? !request.resource.data.keys().hasAny(['secoesResponsaveisIds'])
              : request.resource.data.secoesResponsaveisIds == resource.data.secoesResponsaveisIds
          )
          && request.resource.data.re == resource.data.re
        );
      allow delete: if isGerente()
        || (isAdmin()
          && resource.data.keys().hasAny(['divisaoId'])
          && resource.data.divisaoId == callerDivisao()
          && (
            !resource.data.keys().hasAny(['perfil'])
            || resource.data.perfil != 'Gerente'
          ));
    }

    match /colaboradores/{id} {
      allow read: if isGerente()
        || (isRegistered() && docInexistente())
        || sectionRead();
      allow create: if canEditCadastro()
        && sectionCreateOk()
        && request.resource.data.keys().hasAll(['divisaoId', 'secaoId']);
      allow update: if canEditCadastro()
        && sectionUpdateOk();
      allow delete: if canEditCadastro() && tenantDeleteOk();
    }

    match /secoes/{id} {
      allow read: if isGerente()
        || (isRegistered() && docInexistente())
        || tenantRead();
      allow create: if (isAdmin() || isGerente())
        && tenantCreateOk()
        && request.resource.data.keys().hasAny(['divisaoId'])
        && !request.resource.data.keys().hasAny(['secaoId']);
      allow update: if (isAdmin() || isGerente())
        && tenantUpdateOk()
        && !request.resource.data.keys().hasAny(['secaoId']);
      allow delete: if tenantDeleteOk();
    }

    match /postos/{id} {
      allow read: if tenantRead();
      allow create: if (isAdmin() || isGerente()) && tenantCreateOk();
      allow update: if (isAdmin() || isGerente()) && tenantUpdateOk();
      allow delete: if tenantDeleteOk();
    }

    match /legendas/{id} {
      allow read: if isRegistered() || (isRegistered() && docInexistente());
      allow create, update, delete: if isGerente();
    }

    match /configuracoes/{id} {
      allow read: if isRegistered();
      allow write: if isGerente();
    }

    match /escalas_semanais/{id} {
      allow read: if sectionRead();
      allow create: if canCreateWorkflowDoc();
      allow update: if canWriteWorkflowDoc();
      allow delete: if tenantDeleteOk();
    }

    match /escalas_alteracao/{id} {
      allow read: if sectionRead();
      allow create: if canCreateWorkflowDoc();
      allow update: if canWriteWorkflowDoc();
      allow delete: if tenantDeleteOk();
    }

    match /controle_frequencia/{id} {
      allow read: if sectionRead();
      allow create: if canCreateWorkflowDoc();
      allow update: if canWriteWorkflowDoc();
      allow delete: if tenantDeleteOk();
    }

    match /solicitacoes_aprovacao/{id} {
      allow read: if sectionRead();
      allow create: if canSubmitRole()
        && sectionCreateOk()
        && request.resource.data.keys().hasAll(['divisaoId', 'secaoId']);
      allow update: if sectionUpdateOk()
        && (canSubmitRole() || canApproveRole())
        && request.resource.data.divisaoId == resource.data.divisaoId
        && request.resource.data.secaoId == resource.data.secaoId;
      allow delete: if tenantDeleteOk();
    }

    match /presenca_online/{id} {
      allow read: if isGerente()
        || (isRegistered() && docInexistente())
        || (isRegistered()
            && (!resource.data.keys().hasAny(['divisaoId'])
                || resource.data.divisaoId == callerDivisao()));
      allow create, update: if isRegistered()
        && request.resource.data.keys().hasAny(['re'])
        && request.resource.data.re == callerRe()
        && (
          !request.resource.data.keys().hasAny(['divisaoId'])
          || request.resource.data.divisaoId == callerDivisao()
          || isGerente()
        );
      allow delete: if isRegistered()
        && (
          (resource.data.keys().hasAny(['re']) && resource.data.re == callerRe())
          || isGerente()
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
